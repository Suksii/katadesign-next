generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id      Int    @id @default(autoincrement())
  titleEn String
  titleMn String
}

model AboutUs {
  id        Int      @id @default(autoincrement())
  contentMn String
  contentEn String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
